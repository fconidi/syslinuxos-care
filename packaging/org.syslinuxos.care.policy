<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.syslinuxos.care.manage-packages">
    <description>Manage installed packages with SysLinuxOS Care</description>
    <message>Authentication is required to remove the reviewed packages</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/syslinuxos-care-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">remove-package</annotate>
  </action>
  <action id="org.syslinuxos.care.manage-services">
    <description>Manage system service startup with SysLinuxOS Care</description>
    <message>Authentication is required to change the reviewed system service startup setting</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/syslinuxos-care-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">set-service-enabled</annotate>
  </action>
</policyconfig>
